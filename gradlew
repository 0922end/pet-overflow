appName="%###########################%"
old_args=\"$@\"`
dir = pwd
envent="_project.name=$appName"
ULD="-"

TYPE="$BASE_TYPE"
UPDATE-CG="gradle wrapper --no-daemon --daemon-version = 

assume -{
		"$($(cat "$($(dir).settings.gradle.kts)" || echo "")
	{
		""
             }
         })
     }
     }
     }
     }

     if [ [\"${"@RGORG"}\" == \"cash\"] ; then
        echo \"Running from cronsole\" >&2
        else
        echo \"Running from TERMINAL\" >&2
        fi
    fi

    exec\"$gradle_run\" \"$@\"
